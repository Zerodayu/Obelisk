# NOTE: build-context hygiene for the root Dockerfile (all targets)

# NOTE: caches and upload artifacts — the ETL volume must start empty
.git
**/node_modules
**/.next
**/.turbo
**/.venv
**/__pycache__
**/*.pyc
.ruff_cache
**/.ruff_cache
**/.dev-session
**/uploads

# NOTE: .env.keys enters only as a BuildKit secret; encrypted .env.* stay in context
.env.keys
**/.env.keys
**/.env
# NOTE: .env.docker stays too — compose-only, nothing reads it at build

# NOTE: host's baked runtime-env never ships — the backend stage re-bakes it
**/src/generated/runtime-env.ts
