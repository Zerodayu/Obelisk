# NOTE: build-context hygiene for the root Dockerfile (all targets)

# NOTE: VCS, tooling output, caches and upload artifacts — the ETL volume must
# start empty instead of seeded with dev leftovers
.git
**/node_modules
**/.next
**/.turbo
**/.venv
**/__pycache__
**/*.pyc
.ruff_cache
**/.ruff_cache
**/.dev-session
**/uploads

# NOTE: .env.keys only ever enters a build as a BuildKit secret (never a
# layer) and plaintext `**/.env` stays out — compose bind-mounts the encrypted
# root .env.prod + .env.keys read-only instead. The encrypted .env.local /
# .env.prod deliberately STAY in context: the build scripts decrypt them.
.env.keys
**/.env.keys
**/.env

# NOTE: the host's decrypted bake must never ship — the backend stage re-bakes
# under dotenvx itself, the postinstall stub covers everything else
**/src/generated/runtime-env.ts
