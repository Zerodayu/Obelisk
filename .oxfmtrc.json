{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules",
    "**/.turbo",
    "**/.next",
    "**/dist",
    "**/build",
    "**/*.svg",
    "apps/backend/.agents",
    "apps/frontend/.agents",
    "apps/backend/prisma/generated",
    "apps/backend/skills-lock.json",
    "**/src/generated/runtime-env.ts"
  ]
}
