{
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": [
    "**/node_modules",
    "**/.turbo",
    "**/.next",
    "**/dist",
    "**/build",
    "**/*.svg",
    "apps/backend/.agents",
    "apps/frontend/.agents",
    "apps/backend/prisma/generated",
    "apps/backend/skills-lock.json",
    "**/src/generated/runtime-env.ts"
  ],
  "rules": {
    "shadcn/no-arbitrary-values": "error"
  }
}
