# NOTE: single public entrypoint — hostnames injected by the dotenvx wrap in `just docker-deploy`
# NOTE: admin sites import a guard file — deny.caddy in public mode, local.caddy in deploy-local

{$APP_DOMAIN} {
	encode zstd gzip

	# NOTE: access log → docker json-file → Dozzle — the one hop that sees every request
	# NOTE: `log` names a logger, not a matcher — the exclusion lives in log_skip
	@loggable not path /_next/* /images/* /favicon.ico
	log {
		output stdout
		format json
	}
	log_skip @loggable

	# NOTE: API → in-network backend (no published port); the path passes through as-is
	handle /api/* {
		reverse_proxy backend:8080
	}

	# NOTE: first match wins — keep this catch-all handle last
	handle {
		reverse_proxy frontend:3000
	}

	# NOTE: HSTS only takes effect once the browser has seen the https response
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# NOTE: admin-only log viewer — public host 403s, real access is the tailnet name (tailscale/dozzle.json)
{$DOZZLE_DOMAIN} {
	encode zstd gzip

	# NOTE: own log block — otherwise the 403 peer IP logs nowhere
	log {
		output stdout
		format json
	}

	# NOTE: guard expands in place — respond is ordered before reverse_proxy
	import {$CADDY_ADMIN_GUARD:/etc/caddy/guards/deny.caddy}

	# NOTE: flush_interval -1 — dozzle streams logs over SSE and would buffer
	reverse_proxy dozzle:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# NOTE: admin-only analytics dashboard — tracker paths must stay public for every visitor
{$UMAMI_DOMAIN} {
	encode zstd gzip

	# NOTE: public tracker paths — a matching handle is terminal and bypasses the guard
	@umami_tracker path /script.js /api/send
	handle @umami_tracker {
		reverse_proxy umami:3000
	}

	# NOTE: own log block — otherwise the 403 peer IP logs nowhere; tracker hits skipped as noise
	log {
		output stdout
		format json
	}
	log_skip @umami_tracker

	# NOTE: guard expands in place — handle is ordered before respond, so the tracker paths above bypass it
	import {$CADDY_ADMIN_GUARD:/etc/caddy/guards/deny.caddy}

	reverse_proxy umami:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
