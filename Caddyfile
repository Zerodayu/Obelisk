# NOTE: single public entrypoint — hostnames injected by the dotenvx wrap in `just docker-deploy`
# NOTE: space-separated ADMIN_IPS expands to one remote_ip token per IP

{$APP_DOMAIN} {
	encode zstd gzip

	# NOTE: access log → docker json-file → Dozzle — the one hop that sees every request
	# NOTE: `log` names a logger, not a matcher — the exclusion lives in log_skip
	@loggable not path /_next/* /images/* /favicon.ico
	log {
		output stdout
		format json
	}
	log_skip @loggable

	# NOTE: API → in-network backend (no published port); the path passes through as-is
	handle /api/* {
		reverse_proxy backend:8080
	}

	# NOTE: first match wins — keep this catch-all handle last
	handle {
		reverse_proxy frontend:3000
	}

	# NOTE: HSTS only takes effect once the browser has seen the https response
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# NOTE: admin-only log viewer — ADMIN_IPS must be the client IP as Caddy sees it
{$DOZZLE_DOMAIN} {
	encode zstd gzip

	# NOTE: own log block — otherwise the 403 peer IP logs nowhere
	log {
		output stdout
		format json
	}

	# NOTE: inline remote_ip — `not` can't reference a named matcher here
	@not_admin not remote_ip {$ADMIN_IPS}
	# NOTE: respond runs before reverse_proxy, so denied IPs never reach dozzle
	respond @not_admin 403

	# NOTE: flush_interval -1 — dozzle streams logs over SSE and would buffer
	reverse_proxy dozzle:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# NOTE: admin-only analytics dashboard — tracker paths must stay public for every visitor
{$UMAMI_DOMAIN} {
	encode zstd gzip

	# NOTE: public tracker paths — a matching handle is terminal and bypasses the allow-list
	@umami_tracker path /script.js /api/send
	handle @umami_tracker {
		reverse_proxy umami:3000
	}

	# NOTE: own log block — otherwise the 403 peer IP logs nowhere; tracker hits skipped as noise
	log {
		output stdout
		format json
	}
	log_skip @umami_tracker

	# NOTE: inline remote_ip — `not` can't reference a named matcher here
	@not_admin not remote_ip {$ADMIN_IPS}
	# NOTE: respond runs before reverse_proxy, so denied IPs never reach umami
	respond @not_admin 403

	reverse_proxy umami:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
