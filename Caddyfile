# NOTE: single public entrypoint for the stack — {$APP_DOMAIN} / {$DOZZLE_DOMAIN}
# / {$ADMIN_IPS} are injected into compose by the dotenvx wrap in
# `just docker-deploy` and substituted before parsing, so a space-separated
# ADMIN_IPS expands to one remote_ip token per IP.

{$APP_DOMAIN} {
	encode zstd gzip

	# NOTE: API → in-network backend (no published port); the path passes through as-is
	handle /api/* {
		reverse_proxy backend:8080
	}

	# NOTE: first match wins — keep this catch-all handle last
	handle {
		reverse_proxy frontend:3000
	}

	# NOTE: Caddy sets X-Forwarded-Proto/Host/For on both upstreams by default;
	# HSTS only takes effect once the browser has seen the https response
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# NOTE: admin-only log viewer on its own hostname (no shared origin with the
# app) — `remote_ip` is the whole privacy story here, so ADMIN_IPS must hold
# the client IP as Caddy sees it (public egress, not a LAN address)
{$DOZZLE_DOMAIN} {
	encode zstd gzip

	# NOTE: inline remote_ip — `not` can't reference a named matcher here
	@not_admin not remote_ip {$ADMIN_IPS}
	# NOTE: respond runs before reverse_proxy, so denied IPs never reach dozzle
	respond @not_admin 403

	# NOTE: flush_interval -1 disables response buffering — dozzle streams logs
	# over SSE and buffered proxies would deliver them in bursts or never
	reverse_proxy dozzle:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
