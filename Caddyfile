# NOTE: single public entrypoint for the stack — {$APP_DOMAIN} / {$DOZZLE_DOMAIN}
# / {$UMAMI_DOMAIN} / {$ADMIN_IPS} are injected into compose by the dotenvx wrap
# in `just docker-deploy` and substituted before parsing, so a space-separated
# ADMIN_IPS expands to one remote_ip token per IP.

{$APP_DOMAIN} {
	encode zstd gzip

	# NOTE: access log → stdout → docker json-file → Dozzle (obelisk-caddy) — the
	# one hop that sees every request (next start logs nothing in production)
	@loggable not path /_next/* /images/* /favicon.ico
	log @loggable {
		output stdout
		format json
	}

	# NOTE: API → in-network backend (no published port); the path passes through as-is
	handle /api/* {
		reverse_proxy backend:8080
	}

	# NOTE: first match wins — keep this catch-all handle last
	handle {
		reverse_proxy frontend:3000
	}

	# NOTE: Caddy sets X-Forwarded-Proto/Host/For on both upstreams by default;
	# HSTS only takes effect once the browser has seen the https response
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# NOTE: admin-only log viewer on its own hostname (no shared origin with the
# app) — `remote_ip` is the whole privacy story here, so ADMIN_IPS must hold
# the client IP as Caddy sees it (public egress, not a LAN address)
{$DOZZLE_DOMAIN} {
	encode zstd gzip

	# NOTE: inline remote_ip — `not` can't reference a named matcher here
	@not_admin not remote_ip {$ADMIN_IPS}
	# NOTE: respond runs before reverse_proxy, so denied IPs never reach dozzle
	respond @not_admin 403

	# NOTE: flush_interval -1 disables response buffering — dozzle streams logs
	# over SSE and buffered proxies would deliver them in bursts or never
	reverse_proxy dozzle:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# NOTE: admin-only analytics dashboard on its own hostname — same remote_ip
# story as dozzle, but the tracker itself must stay reachable for every
# visitor's browser or the frontend script records nothing
{$UMAMI_DOMAIN} {
	encode zstd gzip

	# NOTE: public tracker endpoints (GET script, POST hit) — a matching handle
	# is terminal and runs before the respond guard below, so visitors bypass
	# the allow-list only for these two paths
	@umami_tracker path /script.js /api/send
	handle @umami_tracker {
		reverse_proxy umami:3000
	}

	# NOTE: inline remote_ip — `not` can't reference a named matcher here
	@not_admin not remote_ip {$ADMIN_IPS}
	# NOTE: respond runs before reverse_proxy, so denied IPs never reach umami
	# (dashboard, login and stats API all sit behind this)
	respond @not_admin 403

	reverse_proxy umami:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
