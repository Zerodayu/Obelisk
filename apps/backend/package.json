{
	"name": "backend",
	"version": "0.2.0",
	"scripts": {
		"test": "dotenvx run -f ../../.env.local -- bun test/helpers/run-tests.ts",
		"test:unit": "dotenvx run -f ../../.env.local -- bun test -- test/unit",
		"test:integration": "dotenvx run -f ../../.env.local -- bun test/helpers/run-tests.ts -- test/integration",
		"typecheck": "bunx tsc --noEmit",
		"lint": "bunx oxlint .",
		"format": "bunx oxfmt .",
		"dev": "dotenvx run -f ../../.env.local -- bun --watch src/index.ts",
		"start": "dotenvx run -f ../../.env.local -- bun run src/index.ts",
		"start:prod": "dotenvx run -f ../../.env.prod -- bun run src/index.ts",
		"build": "dotenvx run -f ../../.env.local -- bunx prisma generate && dotenvx run -f ../../.env.local -- bun ../../packages/env/scripts/gen-runtime-env.ts",
		"build:prod": "dotenvx run -f ../../.env.prod -- bunx prisma generate && dotenvx run -f ../../.env.prod -- bun ../../packages/env/scripts/gen-runtime-env.ts",
		"db:push": "dotenvx run -f ../../.env.local -- bunx prisma db push",
		"db:generate": "dotenvx run -f ../../.env.local -- bunx prisma generate",
		"db:seed": "dotenvx run -f ../../.env.local -- bun prisma/seed.ts",
		"db:studio": "dotenvx run -f ../../.env.local -- bunx prisma studio",
		"db:migrate": "dotenvx run -f ../../.env.local -- bunx prisma migrate dev",
		"db:push-prod": "dotenvx run -f ../../.env.prod -- bunx prisma db push",
		"db:generate-prod": "dotenvx run -f ../../.env.prod -- bunx prisma generate",
		"db:seed-prod": "NODE_ENV=production dotenvx run -f ../../.env.prod -- bun prisma/seed.ts",
		"db:studio-prod": "dotenvx run -f ../../.env.prod -- bunx prisma studio",
		"db:migrate-prod": "dotenvx run -f ../../.env.prod -- bunx prisma migrate deploy"
	},
	"dependencies": {
		"@better-auth/prisma-adapter": "^1.6.23",
		"@dotenvx/dotenvx": "^2.20.1",
		"@elysia/cors": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"@obelisk/app-info": "workspace:*",
		"@obelisk/env": "workspace:*",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.9.0",
		"@sinclair/typebox": "^0.34.52",
		"better-auth": "^1.6.23",
		"elysia": "latest",
		"elysia-rate-limit": "4.6.3",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"bun-types": "latest",
		"openapi-types": "^12.1.3",
		"prisma": "^7.9.0"
	},
	"module": "src/index.js"
}
