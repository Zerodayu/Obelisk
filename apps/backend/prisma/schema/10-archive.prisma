// Graduation-Cluster Archival (compiled, read-only) — a cluster groups every student finishing their relationship with a program in a given term (graduates, transferees-out, withdrawn).
// Membership keys on the student's ACTUAL graduation/departure term (Student.graduationTermId), never nominal yearLevel — keeps transferees and off-standard-path students safe.
// Compiling consolidates granular rows into write-once GraduationClusterEntry (permanent accreditation evidence, no updatedAt), exports a detail artifact, then purges the hot rows.

model GraduationCluster {
  id                      String                  @id
  programId               String                  @map("program_id")
  graduationTermId        String                  @map("graduation_term_id")
  label                   String
  status                  GraduationClusterStatus @default(open)
  stats                   Json                    @default("{}")
  confirmedByUserId       String?                 @map("confirmed_by_user_id")
  peoAttainmentCapturedAt DateTime?               @map("peo_attainment_captured_at")
  confirmedAt             DateTime?               @map("confirmed_at")
  compiledAt              DateTime?               @map("compiled_at")
  archivedAt              DateTime?               @map("archived_at")
  createdAt               DateTime                @default(now()) @map("created_at")

  program        Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  graduationTerm AcademicTerm             @relation("GraduationClusterTerm", fields: [graduationTermId], references: [id], onDelete: Restrict)
  confirmedBy    user?                    @relation("ClusterConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  students       Student[]                @relation("StudentCluster")
  entries        GraduationClusterEntry[]

  @@unique([programId, graduationTermId])
  @@index([status])
  @@map("graduation_cluster")
}

model GraduationClusterEntry {
  id                     String        @id
  clusterId              String        @map("cluster_id")
  studentId              String        @map("student_id")
  anonymizedId           String        @map("anonymized_id")
  studentStatusAtArchive StudentStatus @map("student_status_at_archive")
  isGraduationEntry      Boolean       @default(true) @map("is_graduation_entry")
  graduatedAt            DateTime?     @map("graduated_at")
  compiledData           Json          @default("{}") @map("compiled_data")
  peoAttainment          Json          @default("{}") @map("peo_attainment")
  detailArtifactUrl      String?       @map("detail_artifact_url")
  purgedRowCounts        Json          @default("{}") @map("purged_row_counts")
  createdAt              DateTime      @default(now()) @map("created_at")

  cluster GraduationCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([studentId])
  @@unique([clusterId, anonymizedId])
  @@index([clusterId])
  @@map("graduation_cluster_entry")
}
