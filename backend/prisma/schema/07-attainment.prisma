model ComputationRun {
  id                String   @id
  triggeredByUserId String?  @map("triggered_by_user_id")
  scope             String
  formulaVersion    String   @default("70_30_v1") @map("formula_version")
  directWeight      Decimal  @default("0.70") @map("direct_weight") @db.Decimal(3, 2)
  indirectWeight    Decimal  @default("0.30") @map("indirect_weight") @db.Decimal(3, 2)
  runAt             DateTime @default(now()) @map("run_at")

  triggeredBy    user?           @relation("TriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  cloAttainments CloAttainment[]
  ploAttainments PloAttainment[]
  uploadRecord   UploadRecord?

  @@map("computation_run")
}

/**
 * Per-upload audit/history for class-record ingestion. One row is created the
 * moment a user uploads a file, then updated to `completed` or `failed` when
 * the ETL job finishes — so the user's upload history (across devices) is
 * recoverable even for failed attempts that never create a `ComputationRun`.
 */
model UploadRecord {
  id               String       @id @default(cuid())
  userId           String       @map("user_id")
  classSectionId   String       @map("class_section_id")
  filename         String
  status           UploadStatus @default(queued)
  error            String?      @db.Text
  etlJobId         String?      @map("etl_job_id")
  computationRunId String?      @unique @map("computation_run_id")
  summary          Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user           user?           @relation("Uploads", fields: [userId], references: [id], onDelete: Cascade)
  classSection   ClassSection    @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  computationRun ComputationRun? @relation(fields: [computationRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("upload_record")
}

model CloAttainment {
  id                String   @id
  classSectionId    String   @map("class_section_id")
  cloId             String   @map("clo_id")
  studentId         String   @map("student_id")
  directScorePct    Decimal? @map("direct_score_pct") @db.Decimal(5, 2)
  indirectScorePct  Decimal? @map("indirect_score_pct") @db.Decimal(5, 2)
  compositeScorePct Decimal  @map("composite_score_pct") @db.Decimal(5, 2)
  isBelowThreshold  Boolean  @default(false) @map("is_below_threshold")
  computationRunId  String   @map("computation_run_id")
  formSubmissionId  String?  @map("form_submission_id")

  classSection   ClassSection    @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  clo            Clo             @relation(fields: [cloId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  computationRun ComputationRun  @relation(fields: [computationRunId], references: [id], onDelete: Cascade)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  atRiskFlags    AtRiskFlag[]

  @@unique([classSectionId, cloId, studentId, computationRunId])
  @@index([isBelowThreshold])
  @@map("clo_attainment")
}

model PloAttainment {
  id                       String  @id
  ploId                    String  @map("plo_id")
  programId                String  @map("program_id")
  termId                   String  @map("term_id")
  attainedPct              Decimal @map("attained_pct") @db.Decimal(5, 2)
  studentsBelowTargetCount Int     @default(0) @map("students_below_target_count")
  computationRunId         String  @map("computation_run_id")
  formSubmissionId         String? @map("form_submission_id")

  plo            Plo             @relation(fields: [ploId], references: [id], onDelete: Cascade)
  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  term           AcademicTerm    @relation(fields: [termId], references: [id], onDelete: Cascade)
  computationRun ComputationRun  @relation(fields: [computationRunId], references: [id], onDelete: Cascade)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)

  @@unique([ploId, programId, termId, computationRunId])
  @@map("plo_attainment")
}

model PeoAttainment {
  id               String  @id
  peoId            String  @map("peo_id")
  programId        String  @map("program_id")
  termId           String  @map("term_id")
  attainedPct      Decimal @map("attained_pct") @db.Decimal(5, 2)
  evidenceJson     Json    @default("{}") @map("evidence_json")
  formSubmissionId String? @map("form_submission_id")

  peo            Peo             @relation(fields: [peoId], references: [id], onDelete: Cascade)
  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  term           AcademicTerm    @relation(fields: [termId], references: [id], onDelete: Cascade)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)

  @@unique([peoId, termId])
  @@map("peo_attainment")
}
