{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/*.svg",
      "!apps/backend/.agents",
      "!apps/backend/prisma/generated",
      "!apps/backend/skills-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/backend/**"],
      "formatter": {
        "indentStyle": "tab"
      },
      "linter": {
        "rules": {
          "preset": "recommended",
          "correctness": {
            "noUnusedImports": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/frontend/**"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      },
      "linter": {
        "rules": {
          "recommended": true,
          "suspicious": {
            "noUnknownAtRules": "off"
          },
          "complexity": {
            "useOptionalChain": "off"
          }
        },
        "domains": {
          "next": "recommended",
          "react": "recommended"
        }
      }
    }
  ]
}
