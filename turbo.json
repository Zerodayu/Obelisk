{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "FRONTEND_URL",
    "PYTHON_SERVER_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "ORG_EMAIL_DOMAIN",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "NEXT_PUBLIC_API_URL",
    "DEVELOPMENT",
    "DEV_SESSION_ENABLED",
    "API_INTERNAL_URL"
  ],
  "globalDependencies": [".env.local", ".env.prod"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false
    },
    "start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false
    },
    "backend#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "typecheck": {
      "outputs": []
    }
  }
}
